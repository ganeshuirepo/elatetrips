{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elatetrips.com/contracts/assignment.schema.json",
  "title": "Assignment — rules-only fulfiller selection & recovery (M20, Δ-003)",
  "description": "Which pooled partner fulfils a booking, chosen by rules ONLY (LLM prohibited, BR-16); every score row carries its rule_id. Refunds are recovery-first and structurally typed (customer_cancel vs service_failure), never inferred. 'Fulfillment done' = fulfillment gate green, mechanically. All timings/thresholds are config (BR-17).",
  "type": "object",
  "properties": {
    "assignment_id": {
      "$ref": "defs/common.schema.json#/$defs/id"
    },
    "booking_id": {
      "$ref": "defs/common.schema.json#/$defs/id"
    },
    "canonical_id": {
      "$ref": "defs/common.schema.json#/$defs/id"
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "pool_size": {
          "type": "integer",
          "minimum": 0
        },
        "freshness_ok": {
          "type": "boolean"
        },
        "lead_days": {
          "type": "integer"
        },
        "match_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "auto_confirm": {
          "type": "boolean"
        }
      },
      "required": [
        "pool_size",
        "freshness_ok",
        "lead_days",
        "match_pct",
        "auto_confirm"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "supplier_id": {
                "$ref": "defs/common.schema.json#/$defs/id"
              },
              "reliability": {
                "type": "number"
              },
              "capacity": {
                "type": "number"
              },
              "margin": {
                "type": "number"
              },
              "fairness_rotation": {
                "type": "number"
              },
              "total": {
                "type": "number"
              },
              "rule_id": {
                "type": "string"
              }
            },
            "required": [
              "supplier_id",
              "total",
              "rule_id"
            ],
            "additionalProperties": false
          }
        },
        "assigned": {
          "$ref": "defs/common.schema.json#/$defs/id"
        },
        "decided_by": {
          "type": "string",
          "enum": [
            "rules",
            "ops_override"
          ],
          "description": "NEVER model (BR-16)."
        },
        "ts": {
          "$ref": "defs/common.schema.json#/$defs/iso_datetime"
        }
      },
      "required": [
        "scores",
        "assigned",
        "decided_by",
        "ts"
      ],
      "additionalProperties": false
    },
    "cascade": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "$ref": "defs/common.schema.json#/$defs/id"
          },
          "offered_ts": {
            "$ref": "defs/common.schema.json#/$defs/iso_datetime"
          },
          "accept_deadline_ts": {
            "$ref": "defs/common.schema.json#/$defs/iso_datetime"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "accepted",
              "declined",
              "timeout",
              "pending"
            ]
          }
        },
        "required": [
          "supplier_id",
          "offered_ts",
          "accept_deadline_ts",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    "sla": {
      "type": "object",
      "properties": {
        "voucher_due_ts": {
          "$ref": "defs/common.schema.json#/$defs/iso_datetime"
        },
        "breach_ts": {
          "$ref": "defs/common.schema.json#/$defs/iso_datetime"
        },
        "deadman_ts": {
          "$ref": "defs/common.schema.json#/$defs/iso_datetime"
        },
        "alerts": {
          "type": "object",
          "properties": {
            "amber_ts": {
              "$ref": "defs/common.schema.json#/$defs/iso_datetime"
            },
            "red_ts": {
              "$ref": "defs/common.schema.json#/$defs/iso_datetime"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "voucher_due_ts",
        "breach_ts",
        "deadman_ts"
      ],
      "additionalProperties": false
    },
    "satisfaction_window": {
      "type": "object",
      "properties": {
        "opens_ts": {
          "$ref": "defs/common.schema.json#/$defs/iso_datetime"
        },
        "closes_ts": {
          "$ref": "defs/common.schema.json#/$defs/iso_datetime"
        },
        "min_days_before_travel": {
          "type": "integer",
          "minimum": 0
        },
        "customer_choice": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "alternate",
            "full_refund",
            null
          ]
        },
        "advance_passthrough_released_ts": {
          "$ref": "defs/common.schema.json#/$defs/iso_datetime"
        }
      },
      "required": [
        "opens_ts",
        "closes_ts"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "substitute_hotel",
                  "substitute_dmc",
                  "manual_followup",
                  "price_adjust"
                ]
              },
              "by": {
                "type": "string",
                "enum": [
                  "sales",
                  "admin"
                ]
              },
              "consent": {
                "type": "object",
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "customer_accepted_ts": {
                    "$ref": "defs/common.schema.json#/$defs/iso_datetime"
                  }
                },
                "required": [
                  "required"
                ],
                "additionalProperties": false
              },
              "floor_check": {
                "type": "string",
                "enum": [
                  "equal_or_better",
                  "downgrade"
                ]
              },
              "delta_refund": {
                "type": "integer",
                "minimum": 0
              },
              "notes": {
                "type": "string"
              },
              "ts": {
                "$ref": "defs/common.schema.json#/$defs/iso_datetime"
              },
              "downgrade": {
                "type": "object",
                "properties": {
                  "permitted_only_if": {
                    "type": "string"
                  },
                  "customer_elected": {
                    "type": "boolean"
                  },
                  "alternatives_evidence_ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "customer_elected",
                  "alternatives_evidence_ref"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "by",
              "consent",
              "floor_check",
              "ts"
            ],
            "additionalProperties": false
          }
        },
        "customer_refund_button_visible_from": {
          "$ref": "defs/common.schema.json#/$defs/iso_datetime"
        }
      },
      "additionalProperties": false
    },
    "refund": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "customer_cancel",
            "service_failure"
          ]
        },
        "triggered_by": {
          "type": "string",
          "enum": [
            "customer_rules",
            "sales",
            "admin",
            "deadman"
          ]
        },
        "maker_checker": {
          "type": "object",
          "properties": {
            "maker": {
              "$ref": "defs/common.schema.json#/$defs/id"
            },
            "checker": {
              "$ref": "defs/common.schema.json#/$defs/id"
            },
            "approved_ts": {
              "$ref": "defs/common.schema.json#/$defs/iso_datetime"
            }
          },
          "additionalProperties": false
        },
        "amount": {
          "type": "string",
          "description": "full+fees+credit | policy_computed | full_no_questions — the label; the money is computed by M14."
        }
      },
      "required": [
        "type",
        "triggered_by"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "accepted",
        "cascading",
        "recovering",
        "fulfilled",
        "refunded"
      ]
    }
  },
  "required": [
    "assignment_id",
    "booking_id",
    "canonical_id",
    "eligibility",
    "decision",
    "sla",
    "status"
  ],
  "additionalProperties": false
}
