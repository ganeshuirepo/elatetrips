# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (frontend dev server)
CORS_ORIGINS=http://localhost:3000

# MongoDB — copy this file to `.env` and fill in real values there (.env is
# git-ignored; NEVER put real credentials in this committed example).
#
# Local default:
MONGODB_URI=mongodb://127.0.0.1:27017/elatetrips
#
# MongoDB Atlas (SRV form — preferred when your runtime can resolve SRV DNS):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/elatetrips?retryWrites=true&w=majority
#
# Atlas standard form — use this if Node's DNS can't resolve SRV records
# (querySrv ECONNREFUSED); paste the three shard hosts + replicaSet from Atlas:
# MONGODB_URI=mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/elatetrips?ssl=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority

# Auth (OTP -> JWT)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# OTP delivery providers — ALL OPTIONAL. Any channel without a provider falls
# back to printing the OTP in the server console, and in non-production the
# API response also includes `devOtp`, so the flow is fully testable with no
# third-party account at all.
# ---------------------------------------------------------------------------

# EMAIL OTP — Brevo (https://www.brevo.com), free tier: 300 emails/day, no
# credit card. Setup: sign up -> Settings -> SMTP & API -> Generate API key
# (starts with "xkeysib-"). BREVO_FROM_EMAIL must be the email you signed up
# with (or a verified sender from Settings -> Senders).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ElateTrips

# SMS OTP option A — Twilio (https://www.twilio.com/try-twilio), free trial
# credit, no card. Limitation: trial accounts can only text numbers you verify
# in the Twilio console (fine for testing). Get a trial number, then copy the
# Account SID + Auth Token from the console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMS OTP option B — Fast2SMS (https://www.fast2sms.com), India-only, ₹50 free
# signup credit. The OTP route used here works without DLT registration.
# Setup: sign up -> Dev API section -> copy the API key.
# If both Twilio and Fast2SMS are configured, Twilio wins.
FAST2SMS_API_KEY=

# ---------------------------------------------------------------------------
# RFQ AUTO-DISPATCH — customer confirms, partners get mailed, customer is told
#
# Two independent switches. The SMTP block makes email *possible*; RFQFLOW_*
# makes the dispatch *happen*. With neither set the behaviour is exactly what it
# was: submit flips a status, and every message is logged instead of sent.
# ---------------------------------------------------------------------------

# The mailbox. All four are required together — a partial config is treated as
# no config, so email stays a log line rather than half-working. Google
# Workspace needs an App Password here, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Elate Trips <connect@elatetrips.com>
MAIL_REPLY_TO=connect@elatetrips.com

# DIVERT EVERY OUTBOUND MESSAGE to one inbox, keeping the address it would have
# gone to in the subject and an X-Elate-Intended-To header. Set this in any
# environment where the supplier directory is not yet real — it is the
# difference between exercising the workflow and mailing actual businesses.
COMM_TEST_RECIPIENT=

# M4 will not transmit on a channel that is not listed here (BR-2).
COMM_ENABLED_CHANNELS=["email"]
COMM_CHANNEL_ORDER=["in_app","email","sms","whatsapp","voice"]

# Addresses the frozen contracts do not carry. Suppliers onboarded through M3
# with a `quoter` contact need no entry here; the map covers the rest.
COMM_SUPPLIER_EMAILS={}
COMM_OPS_EMAIL=
COMM_CUSTOMER_EMAIL=

# The dispatch itself. Off by default: turning it on means a customer
# confirmation immediately mails real partners.
RFQFLOW_ENABLED=false
RFQFLOW_RESPONSE_WINDOW_HOURS=24
RFQFLOW_MAX_SUPPLIERS_PER_WAVE=5
RFQFLOW_NOTIFY_CUSTOMER=true
RFQFLOW_COPY_OPS=true
# RFQFLOW_TRACK=A
# Where a quote-card token becomes a clickable link. Required when sending —
# without it the mail carries a bare token no supplier can use.
RFQFLOW_LINK_BASE=https://www.elatetrips.com/partner/card
